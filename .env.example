# Copy this file to .env.local and fill in your values
# Never commit .env.local to git

# ---------------------------------------------------------------------------
# Contact form (required for /contact to actually deliver mail)
# ---------------------------------------------------------------------------

# Resend API key — get from resend.com (free tier is fine to start)
RESEND_API_KEY=your_resend_api_key_here

# The "from" address on contact-form emails.
# Must be on a domain you have verified in the Resend dashboard.
# If unset, the app falls back to Resend's shared test sender
# (onboarding@resend.dev), which only delivers to your own account email.
CONTACT_FROM_EMAIL="Codecrons Website <website@codecrons.com>"
